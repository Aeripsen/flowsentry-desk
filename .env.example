# Copy to .env (gitignored). Every line is optional: with none of them the desk runs on
# the deterministic policy and the recorded runs.

# Claude through the Anthropic API (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
# claude-sonnet-5-5 is the default
DESK_MODEL=
# 1 = the Run button calls the model live (capped per workspace and per day below)
DESK_LIVE_AGENT=0
DESK_RUNS_PER_WORKSPACE=25
DESK_RUNS_PER_DAY=300

# Clerk sign-in (dashboard.clerk.com > API keys). DESK_AUTH=clerk turns it on.
DESK_AUTH=anon
CLERK_PUBLISHABLE_KEY=
# optional: the PEM public key from the same page, for verification with no network call
CLERK_JWT_KEY=
# the origin(s) the app is served from, for the token's azp check
DESK_ALLOWED_ORIGINS=

# where SQLite lives (labels, runs, audit); /tmp in the container
DESK_DB_PATH=
